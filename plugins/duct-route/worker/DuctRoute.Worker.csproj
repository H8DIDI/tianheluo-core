<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DuctRoute.Worker</AssemblyName>
    <RootNamespace>KaifaTools.DuctRoute</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Model.cs" Link="Model.cs" />
    <Compile Include="..\Geometry.cs" Link="Geometry.cs" />
    <Compile Include="..\Solver.cs" Link="Solver.cs" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>
</Project>
