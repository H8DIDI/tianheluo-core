<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI smoke test for 标注检查: runs the built TagCheck.dll with fake rows. Revit itself is not started. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Revit API types (Autodesk.Revit.DB) are needed to load TagCheck.dll; the reference assembly from the NuGet cache is enough -->
    <Reference Include="RevitAPI">
      <HintPath>$(NuGetPackageRoot)nice3point.revit.api.revitapi\2026.0.4\ref\net8.0\RevitAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TagCheck">
      <HintPath>..\..\plugins\tag-check\bin\Release\net8.0-windows\TagCheck.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
